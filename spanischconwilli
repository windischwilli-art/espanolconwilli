<!DOCTYPE html>
<html lang="de">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>El Camino del Español</title>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600..800&family=Work+Sans:wght@400;500;600;700&display=swap');

  :root {
    --ink: #0F2E2C;
    --panel: #153E3B;
    --panel-light: #1D4B47;
    --cream: #FBF3E6;
    --cream-dim: #CFE3DD;
    --coral: #FF6B54;
    --coral-dark: #E5573F;
    --gold: #F2B705;
    --gold-dark: #C99500;
    --mint: #5FD1A0;
    --mint-dark: #3FAE82;
    --red: #FF5C5C;
    --line: rgba(251,243,230,0.14);
  }

  * { box-sizing: border-box; }

  body {
    margin: 0;
    background: #081E1D;
    font-family: 'Work Sans', sans-serif;
    color: var(--cream);
    display: flex;
    justify-content: center;
    padding: 24px 12px;
    min-height: 100vh;
  }

  .font-display { font-family: 'Fraunces', serif; }

  #app {
    width: 100%;
    max-width: 480px;
    min-height: 680px;
    background: var(--ink);
    border-radius: 28px;
    overflow: hidden;
    box-shadow: 0 20px 60px rgba(0,0,0,0.4);
    display: flex;
    flex-direction: column;
    position: relative;
  }

  .screen { display: none; flex-direction: column; flex: 1; }
  .screen.active { display: flex; }

  /* --- TopBar --- */
  .topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 20px;
    border-bottom: 1px solid var(--line);
  }
  .back-btn {
    display: flex;
    align-items: center;
    gap: 4px;
    background: none;
    border: none;
    color: var(--cream-dim);
    font-family: 'Work Sans', sans-serif;
    font-size: 14px;
    cursor: pointer;
    padding: 0;
  }
  .stats { display: flex; align-items: center; gap: 16px; }
  .stat { display: flex; align-items: center; gap: 5px; font-weight: 600; font-size: 14px; font-variant-numeric: tabular-nums; }
  .hearts { display: flex; gap: 3px; }

  /* --- Progress bar --- */
  .progress-wrap { padding: 12px 20px 0; }
  .progress-track {
    height: 8px;
    border-radius: 999px;
    background: var(--panel-light);
    overflow: hidden;
  }
  .progress-fill {
    height: 100%;
    border-radius: 999px;
    background: var(--coral);
    transition: width 0.3s ease;
  }
  .progress-fill.mint { background: var(--mint); }

  /* --- Levels screen --- */
  .levels-header { padding: 32px 24px 4px; }
  .eyebrow {
    font-size: 12px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--coral);
    margin: 0 0 6px;
    font-weight: 600;
  }
  .big-title { font-size: 28px; font-weight: 700; margin: 0; }
  .sub-text { font-size: 14px; color: var(--cream-dim); margin: 8px 0 0; }

  .level-list {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 24px 24px 32px;
  }
  .level-card {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 18px 20px;
    border-radius: 20px;
    border: 1.5px solid var(--line);
    background: var(--panel);
    cursor: pointer;
    text-align: left;
    width: 100%;
    transition: transform 0.15s ease, border-color 0.15s ease;
    animation: popIn 0.3s cubic-bezier(.2,.9,.3,1.2);
  }
  .level-card:hover:not(:disabled) { transform: translateY(-2px); }
  .level-card:active:not(:disabled) { transform: scale(0.98); }
  .level-card:disabled { cursor: not-allowed; opacity: 0.55; }
  .level-icon {
    width: 54px; height: 54px;
    border-radius: 16px;
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0;
  }
  .level-info { flex: 1; min-width: 0; }
  .level-name { font-family: 'Fraunces', serif; font-weight: 700; font-size: 18px; margin: 0; }
  .level-tag { font-size: 12px; color: var(--cream-dim); margin: 2px 0 8px; }
  .level-track { height: 6px; border-radius: 999px; background: var(--panel-light); overflow: hidden; }
  .level-track-fill { height: 100%; border-radius: 999px; }
  .level-count { font-size: 11px; color: var(--cream-dim); margin: 6px 0 0; font-variant-numeric: tabular-nums; }
  .level-chevron { flex-shrink: 0; }

  /* --- Path screen --- */
  .path-header { padding: 28px 24px 0; }
  .path-title { font-size: 24px; font-weight: 700; margin: 0; }
  .path-sub { font-size: 14px; color: var(--cream-dim); margin: 8px 0 0; }

  .path-body {
    position: relative;
    max-width: 340px;
    margin: 36px auto 20px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 56px;
    padding-bottom: 20px;
  }
  .path-line {
    position: absolute;
    left: 50%;
    top: 0;
    bottom: 0;
    width: 3px;
    transform: translateX(-50%);
    background-image: linear-gradient(var(--line) 40%, transparent 0%);
    background-position: center;
    background-size: 3px 16px;
    background-repeat: repeat-y;
    z-index: 0;
  }

  .chapter-node { position: relative; display: flex; flex-direction: column; align-items: center; z-index: 1; animation: popIn 0.3s cubic-bezier(.2,.9,.3,1.2); }
  .node-btn {
    width: 76px;
    height: 76px;
    border-radius: 50%;
    border: none;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    background: var(--panel-light);
    transition: transform 0.15s ease;
  }
  .node-btn:hover:not(:disabled) { transform: scale(1.06); }
  .node-btn:active:not(:disabled) { transform: scale(0.95); }
  .node-btn.unlocked { background: var(--coral); box-shadow: 0 6px 0 0 var(--coral-dark); }
  .node-btn.done { background: var(--mint); box-shadow: 0 6px 0 0 var(--mint-dark); }
  .node-btn:disabled { cursor: not-allowed; }
  .node-btn svg { width: 30px; height: 30px; }

  .node-stars {
    position: absolute;
    bottom: -8px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 2px;
    background: var(--ink);
    padding: 2px 6px;
    border-radius: 999px;
  }
  .node-label { text-align: center; margin-top: 14px; }
  .node-label .name { font-family: 'Fraunces', serif; font-weight: 700; font-size: 16px; margin: 0; }
  .node-label .meta { font-size: 12px; color: var(--cream-dim); margin: 2px 0 0; }
  .node-label .name.locked { color: var(--cream-dim); }

  /* --- Flashcard screen --- */
  .card-area { flex: 1; display: flex; align-items: center; justify-content: center; padding: 24px 32px; }
  .flashcard {
    width: 100%;
    max-width: 340px;
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 24px;
    padding: 32px;
    text-align: center;
    animation: popIn 0.28s cubic-bezier(.2,.9,.3,1.2);
  }
  .flashcard .eyebrow { margin-bottom: 16px; }
  .card-word-row { display: flex; align-items: center; justify-content: center; gap: 8px; margin-bottom: 12px; }
  .card-word { font-family: 'Fraunces', serif; font-size: 34px; font-weight: 700; margin: 0; }
  .card-de { font-size: 18px; color: var(--gold); margin: 0 0 22px; }
  .card-ex {
    font-size: 14px;
    font-style: italic;
    color: var(--cream-dim);
    border-top: 1px solid var(--line);
    padding-top: 16px;
    margin: 0;
  }
  .cta-wrap { padding: 8px 24px 32px; }
  .btn-primary {
    width: 100%;
    max-width: 340px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 16px;
    border: none;
    border-radius: 16px;
    background: var(--coral);
    color: var(--ink);
    font-family: 'Work Sans', sans-serif;
    font-weight: 600;
    font-size: 16px;
    box-shadow: 0 5px 0 0 var(--coral-dark);
    cursor: pointer;
    transition: transform 0.1s ease;
  }
  .btn-primary:active { transform: translateY(2px); box-shadow: 0 3px 0 0 var(--coral-dark); }
  .btn-primary.mint { background: var(--mint); box-shadow: 0 5px 0 0 var(--mint-dark); color: var(--ink); }
  .btn-primary.mint:active { box-shadow: 0 3px 0 0 var(--mint-dark); }
  .btn-secondary {
    width: 100%;
    max-width: 340px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 14px;
    border: 1.5px solid var(--line);
    border-radius: 16px;
    background: transparent;
    color: var(--cream-dim);
    font-family: 'Work Sans', sans-serif;
    font-weight: 600;
    font-size: 15px;
    cursor: pointer;
  }

  /* --- Quiz screen --- */
  .quiz-area { flex: 1; display: flex; flex-direction: column; justify-content: center; padding: 24px 24px 32px; }
  .quiz-prompt { text-align: center; font-size: 14px; color: var(--cream-dim); margin: 0 0 8px; }
  .quiz-word { font-family: 'Fraunces', serif; font-size: 34px; font-weight: 700; text-align: center; margin: 0 0 28px; animation: popIn 0.28s cubic-bezier(.2,.9,.3,1.2); }
  .options { display: flex; flex-direction: column; gap: 12px; max-width: 340px; margin: 0 auto; width: 100%; }
  .option-btn {
    text-align: left;
    padding: 16px 20px;
    border-radius: 16px;
    border: 1.5px solid var(--line);
    background: var(--panel);
    color: var(--cream);
    font-family: 'Work Sans', sans-serif;
    font-size: 15px;
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    transition: background 0.15s ease, border-color 0.15s ease;
  }
  .option-btn:disabled { cursor: default; }
  .option-btn.correct { background: rgba(95,209,160,0.18); border-color: var(--mint); }
  .option-btn.wrong { background: rgba(255,92,92,0.18); border-color: var(--red); animation: shake 0.4s; }
  .option-btn svg { width: 18px; height: 18px; }

  /* --- Result screen --- */
  .result-area {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 32px;
    text-align: center;
  }
  .result-icon {
    width: 96px; height: 96px;
    border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    margin-bottom: 24px;
    animation: popIn 0.3s cubic-bezier(.2,.9,.3,1.2);
  }
  .result-icon.win { background: rgba(242,183,5,0.15); }
  .result-icon.fail { background: rgba(255,92,92,0.15); }
  .result-title { font-family: 'Fraunces', serif; font-size: 28px; font-weight: 700; margin: 0 0 8px; }
  .result-text { font-size: 14px; color: var(--cream-dim); margin: 0 0 24px; max-width: 300px; }
  .result-stars { display: flex; gap: 8px; margin-bottom: 32px; }
  .result-actions { width: 100%; max-width: 260px; display: flex; flex-direction: column; gap: 12px; }

  @keyframes popIn { 0% { transform: scale(0.85); opacity: 0; } 100% { transform: scale(1); opacity: 1; } }
  @keyframes shake { 10%,90%{transform:translateX(-1px)} 20%,80%{transform:translateX(2px)} 30%,50%,70%{transform:translateX(-4px)} 40%,60%{transform:translateX(4px)} }
  @media (prefers-reduced-motion: reduce) {
    .chapter-node, .flashcard, .quiz-word, .result-icon, .level-card { animation: none; }
    .option-btn.wrong { animation: none; }
  }

  button:focus-visible, .node-btn:focus-visible {
    outline: 2px solid var(--gold);
    outline-offset: 2px;
  }
</style>
</head>
<body>

<div id="app">

  <!-- ================= LEVELS SCREEN ================= -->
  <section class="screen active" id="screen-levels">
    <div class="levels-header">
      <p class="eyebrow">El Camino del Español</p>
      <h1 class="big-title font-display">Wähle dein Niveau</h1>
      <p class="sub-text">Von den ersten Wörtern bis zum sicheren Alltagsspanisch — Schritt für Schritt durch Spanien.</p>
    </div>
    <div class="level-list" id="level-list"></div>
  </section>

  <!-- ================= PATH SCREEN ================= -->
  <section class="screen" id="screen-path">
    <div class="topbar">
      <button class="back-btn" onclick="goToLevels()">&larr; Niveaus</button>
      <div></div>
    </div>
    <div class="path-header">
      <p class="eyebrow" id="path-eyebrow"></p>
      <h1 class="path-title font-display" id="path-title"></h1>
      <p class="path-sub" id="path-sub"></p>
    </div>
    <div class="path-body" id="path-body">
      <div class="path-line"></div>
    </div>
  </section>

  <!-- ================= FLASHCARD SCREEN ================= -->
  <section class="screen" id="screen-cards">
    <div class="topbar">
      <button class="back-btn" onclick="goToPath(state.levelId)">&larr; Ruta</button>
      <div></div>
    </div>
    <div class="progress-wrap">
      <div class="progress-track"><div class="progress-fill" id="card-progress"></div></div>
    </div>
    <div class="card-area">
      <div class="flashcard" id="flashcard">
        <p class="eyebrow" id="card-eyebrow"></p>
        <div class="card-word-row">
          <h2 class="card-word font-display" id="card-word"></h2>
          <svg viewBox="0 0 24 24" fill="none" stroke="#CFE3DD" stroke-width="2" width="20" height="20"><path d="M11 5 6 9H2v6h4l5 4V5Z"/><path d="M19.07 4.93a10 10 0 0 1 0 14.14M15.54 8.46a5 5 0 0 1 0 7.07"/></svg>
        </div>
        <p class="card-de" id="card-de"></p>
        <p class="card-ex" id="card-ex"></p>
      </div>
    </div>
    <div class="cta-wrap">
      <button class="btn-primary" id="card-next-btn" onclick="nextCard()">
        <span id="card-next-label">Weiter</span>
        <svg viewBox="0 0 24 24" fill="none" stroke="#0F2E2C" stroke-width="2.4" width="18" height="18"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
      </button>
    </div>
  </section>

  <!-- ================= QUIZ SCREEN ================= -->
  <section class="screen" id="screen-quiz">
    <div class="topbar">
      <button class="back-btn" onclick="goToPath(state.levelId)">&larr; Ruta</button>
      <div class="stats">
        <div class="stat" style="color: var(--gold)">
          <svg viewBox="0 0 24 24" width="17" height="17" fill="#F2B705"><path d="M12 2l2.9 6.6L22 9.3l-5 4.8 1.3 7-6.3-3.6L5.7 21l1.3-7-5-4.8 7.1-0.7L12 2z"/></svg>
          <span id="quiz-xp">0 XP</span>
        </div>
        <div class="stat" style="color: var(--coral)">
          <svg viewBox="0 0 24 24" width="17" height="17" fill="#FF6B54"><path d="M12 2c1 4-3 5-3 9a3 3 0 0 0 6 0c0-1-.5-2-1-2 2 1 3 3 3 5a5 5 0 0 1-10 0c0-5 5-6 5-12z"/></svg>
          <span id="quiz-streak">0</span>
        </div>
        <div class="hearts" id="quiz-hearts"></div>
      </div>
    </div>
    <div class="progress-wrap">
      <div class="progress-track"><div class="progress-fill mint" id="quiz-progress"></div></div>
    </div>
    <div class="quiz-area">
      <p class="quiz-prompt">Was bedeutet dieses Wort?</p>
      <h2 class="quiz-word font-display" id="quiz-word"></h2>
      <div class="options" id="quiz-options"></div>
    </div>
  </section>

  <!-- ================= RESULT SCREEN ================= -->
  <section class="screen" id="screen-result">
    <div class="result-area">
      <div class="result-icon" id="result-icon"></div>
      <h2 class="result-title" id="result-title"></h2>
      <p class="result-text" id="result-text"></p>
      <div class="result-stars" id="result-stars"></div>
      <div class="result-actions" id="result-actions"></div>
    </div>
  </section>

</div>


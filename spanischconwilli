const ALL_WORDS = CHAPTERS.flatMap(c => c.words);
const CH_BY_ID = Object.fromEntries(CHAPTERS.map(c => [c.id, c]));

/* ---------------------------------------------------------
   Niveaustufen
--------------------------------------------------------- */
const LEVELS = [
  {
    id: "beginner",
    name: "Anfänger",
    tag: "A1 · Grundlagen",
    accent: "coral",
    icon: '<path d="M12 2v4M12 18v4M4.9 4.9l2.8 2.8M16.3 16.3l2.8 2.8M2 12h4M18 12h4M4.9 19.1l2.8-2.8M16.3 7.7l2.8-2.8"/><circle cx="12" cy="12" r="3"/>',
    chapters: ["hola", "familia", "comida"],
  },
  {
    id: "intermediate",
    name: "Fortgeschritten",
    tag: "A2–B1 · Alltag",
    accent: "gold",
    icon: '<circle cx="12" cy="12" r="10"/><path d="m16.2 7.8-2.2 6.2-6.2 2.2 2.2-6.2z"/>',
    chapters: ["viaje", "numeros", "ciudad"],
  },
  {
    id: "advanced",
    name: "Profi",
    tag: "B2 · Vertiefung",
    accent: "mint",
    icon: '<path d="M12 2 4 6v6c0 5 3.4 8.7 8 10 4.6-1.3 8-5 8-10V6z"/>',
    chapters: ["trabajo", "tiempo", "sentimientos"],
  },
];
const LEVEL_BY_ID = Object.fromEntries(LEVELS.map(l => [l.id, l]));
const ACCENT_VARS = {
  coral: { main: "var(--coral)", dark: "var(--coral-dark)" },
  gold: { main: "var(--gold)", dark: "var(--gold-dark)" },
  mint: { main: "var(--mint)", dark: "var(--mint-dark)" },
};

const LOCK_SVG = '<path d="M19 11H5a2 2 0 0 0-2 2v7a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7a2 2 0 0 0-2-2Z"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/>';
const CHEVRON_SVG = '<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"/></svg>';
const STAR_SVG = (filled) => `<svg viewBox="0 0 24 24" width="14" height="14" fill="${filled ? '#F2B705' : 'none'}" stroke="#F2B705" stroke-width="1.5"><path d="M12 2l2.9 6.6L22 9.3l-5 4.8 1.3 7-6.3-3.6L5.7 21l1.3-7-5-4.8 7.1-0.7L12 2z"/></svg>`;

/* ---------------------------------------------------------
   State
--------------------------------------------------------- */
let state = {
  levelId: null,
  chapterId: null,
  cardIndex: 0,
  quiz: [],
  qIndex: 0,
  hearts: 3,
  correctCount: 0,
  xp: 0,
  streak: 0,
  progress: Object.fromEntries(CHAPTERS.map(c => [c.id, { done: false, stars: 0 }])),
  lastGain: 0,
  lastFailed: false,
};

function shuffle(arr) {
  const a = [...arr];
  for (let i = a.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    [a[i], a[j]] = [a[j], a[i]];
  }
  return a;
}

function buildQuiz(chapter) {
  const pool = shuffle(chapter.words).slice(0, 6);
  return pool.map(word => {
    const distractors = shuffle(ALL_WORDS.filter(w => w.de !== word.de)).slice(0, 3);
    const options = shuffle([word.de, ...distractors.map(w => w.de)]);
    return { word, options };
  });
}

function showScreen(id) {
  document.querySelectorAll('.screen').forEach(s => s.classList.remove('active'));
  document.getElementById(id).classList.add('active');
}

/* ---------------------------------------------------------
   Unlock-Logik
--------------------------------------------------------- */
function isLevelUnlocked(levelIdx) {
  if (levelIdx === 0) return true;
  const prev = LEVELS[levelIdx - 1];
  return prev.chapters.every(id => state.progress[id].done);
}

function isChapterUnlocked(level, chapterIdxInLevel, levelIdx) {
  if (!isLevelUnlocked(levelIdx)) return false;
  if (chapterIdxInLevel === 0) return true;
  const prevId = level.chapters[chapterIdxInLevel - 1];
  return state.progress[prevId].done;
}

/* ---------------------------------------------------------
   Levels screen
--------------------------------------------------------- */
function renderLevels() {
  const list = document.getElementById('level-list');
  list.innerHTML = '';

  LEVELS.forEach((level, idx) => {
    const unlocked = isLevelUnlocked(idx);
    const doneCount = level.chapters.filter(id => state.progress[id].done).length;
    const total = level.chapters.length;
    const accent = ACCENT_VARS[level.accent];

    const card = document.createElement('button');
    card.className = 'level-card';
    card.disabled = !unlocked;
    card.onclick = () => unlocked && goToPath(level.id);
    card.style.animationDelay = `${idx * 0.05}s`;

    const iconSvg = unlocked
      ? `<svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="${accent.main}" stroke-width="2">${level.icon}</svg>`
      : `<svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="var(--cream-dim)" stroke-width="2">${LOCK_SVG}</svg>`;

    card.innerHTML = `
      <div class="level-icon" style="background:${unlocked ? 'rgba(255,255,255,0.06)' : 'var(--panel-light)'}">${iconSvg}</div>
      <div class="level-info">
        <p class="level-name">${level.name}</p>
        <p class="level-tag">${level.tag}${unlocked ? '' : ' · gesperrt'}</p>
        <div class="level-track">
          <div class="level-track-fill" style="width:${(doneCount/total)*100}%; background:${accent.main}"></div>
        </div>
        <p class="level-count">${doneCount}/${total} Kapitel abgeschlossen</p>
      </div>
      <div class="level-chevron" style="color:var(--cream-dim)">${CHEVRON_SVG}</div>
    `;
    list.appendChild(card);
  });
}

function goToLevels() {
  renderLevels();
  showScreen('screen-levels');
}

/* ---------------------------------------------------------
   Path screen
--------------------------------------------------------- */
const OFFSETS = [0, 56, -20];

function renderPath() {
  const level = LEVEL_BY_ID[state.levelId];
  const levelIdx = LEVELS.findIndex(l => l.id === level.id);

  document.getElementById('path-eyebrow').textContent = `${level.name} · ${level.tag}`;
  document.getElementById('path-title').textContent = 'Deine Route durchs Spanische';
  document.getElementById('path-sub').textContent = 'Jede Station ist eine Stadt, jedes Kapitel ein neuer Stempel im Reisepass.';

  const body = document.getElementById('path-body');
  body.querySelectorAll('.chapter-node').forEach(n => n.remove());

  level.chapters.forEach((chId, i) => {
    const ch = CH_BY_ID[chId];
    const st = state.progress[ch.id];
    const unlocked = isChapterUnlocked(level, i, levelIdx);

    const node = document.createElement('div');
    node.className = 'chapter-node';
    node.style.transform = `translateX(${OFFSETS[i % OFFSETS.length]}px)`;

    const btnClass = unlocked ? (st.done ? 'node-btn done' : 'node-btn unlocked') : 'node-btn';
    const iconSvg = unlocked
      ? `<svg viewBox="0 0 24 24" fill="none" stroke="#0F2E2C" stroke-width="2.2" width="30" height="30">${ch.icon}</svg>`
      : `<svg viewBox="0 0 24 24" fill="none" stroke="#CFE3DD" stroke-width="2" width="26" height="26">${LOCK_SVG}</svg>`;

    const starsHtml = st.done
      ? `<div class="node-stars">${[0,1,2].map(s => STAR_SVG(s < st.stars)).join('')}</div>`
      : '';

    node.innerHTML = `
      <button class="${btnClass}" ${unlocked ? '' : 'disabled'} onclick="openChapter('${ch.id}')">
        ${iconSvg}
        ${starsHtml}
      </button>
      <div class="node-label">
        <p class="name font-display ${unlocked ? '' : 'locked'}">${ch.title}</p>
        <p class="meta">${ch.subtitle} · ${ch.stop}</p>
      </div>
    `;
    body.appendChild(node);
  });
}

function goToPath(levelId) {
  state.levelId = levelId;
  renderPath();
  showScreen('screen-path');
}

/* ---------------------------------------------------------
   Flashcard screen
--------------------------------------------------------- */
function openChapter(chapterId) {
  state.chapterId = chapterId;
  state.cardIndex = 0;
  renderCard();
  showScreen('screen-cards');
}

function renderCard() {
  const chapter = CH_BY_ID[state.chapterId];
  const word = chapter.words[state.cardIndex];
  const total = chapter.words.length;

  document.getElementById('card-progress').style.width = `${((state.cardIndex + 1) / total) * 100}%`;
  document.getElementById('card-eyebrow').textContent = `${chapter.subtitle} · ${state.cardIndex + 1}/${total}`;
  document.getElementById('card-word').textContent = word.es;
  document.getElementById('card-de').textContent = word.de;
  document.getElementById('card-ex').textContent = `„${word.ex}“`;
  document.getElementById('card-next-label').textContent = (state.cardIndex + 1 < total) ? 'Weiter' : 'Zum Quiz';

  const card = document.getElementById('flashcard');
  card.style.animation = 'none';
  void card.offsetWidth;
  card.style.animation = '';
}

function nextCard() {
  const chapter = CH_BY_ID[state.chapterId];
  if (state.cardIndex + 1 < chapter.words.length) {
    state.cardIndex++;
    renderCard();
  } else {
    state.quiz = buildQuiz(chapter);
    state.qIndex = 0;
    state.hearts = 3;
    state.correctCount = 0;
    renderQuiz();
    showScreen('screen-quiz');
  }
}

/* ---------------------------------------------------------
   Quiz screen
--------------------------------------------------------- */
function renderHearts() {
  const el = document.getElementById('quiz-hearts');
  el.innerHTML = [0,1,2].map(i => `
    <svg viewBox="0 0 24 24" width="17" height="17" fill="${i < state.hearts ? '#FF5C5C' : 'none'}" stroke="#FF5C5C" stroke-width="1.8">
      <path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.6l-1-1a5.5 5.5 0 0 0-7.8 7.8l1 1L12 21l7.8-7.6 1-1a5.5 5.5 0 0 0 0-7.8Z"/>
    </svg>
  `).join('');
}

function renderQuiz() {
  const q = state.quiz[state.qIndex];
  document.getElementById('quiz-progress').style.width = `${(state.qIndex / state.quiz.length) * 100}%`;
  document.getElementById('quiz-xp').textContent = `${state.xp} XP`;
  document.getElementById('quiz-streak').textContent = state.streak;
  renderHearts();

  const wordEl = document.getElementById('quiz-word');
  wordEl.textContent = q.word.es;
  wordEl.style.animation = 'none';
  void wordEl.offsetWidth;
  wordEl.style.animation = '';

  const opts = document.getElementById('quiz-options');
  opts.innerHTML = '';
  q.options.forEach(opt => {
    const btn = document.createElement('button');
    btn.className = 'option-btn';
    btn.textContent = opt;
    btn.onclick = () => answerQuiz(opt);
    opts.appendChild(btn);
  });
}

const CHECK_SVG = '<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="#5FD1A0" stroke-width="2.4"><path d="M20 6 9 17l-5-5"/></svg>';
const X_SVG = '<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="#FF5C5C" stroke-width="2.4"><path d="M18 6 6 18M6 6l12 12"/></svg>';

function answerQuiz(opt) {
  const q = state.quiz[state.qIndex];
  const correct = opt === q.word.de;
  const buttons = document.querySelectorAll('#quiz-options .option-btn');

  buttons.forEach(btn => {
    btn.disabled = true;
    if (btn.textContent === opt) {
      btn.classList.add(correct ? 'correct' : 'wrong');
      btn.innerHTML = `<span>${btn.textContent}</span>${correct ? CHECK_SVG : X_SVG}`;
    } else if (btn.textContent === q.word.de) {
      btn.classList.add('correct');
      btn.innerHTML = `<span>${btn.textContent}</span>${CHECK_SVG}`;
    }
  });

  if (correct) {
    state.correctCount++;
    state.xp += 10;
    state.streak++;
  } else {
    state.streak = 0;
    state.hearts--;
  }
  document.getElementById('quiz-xp').textContent = `${state.xp} XP`;
  document.getElementById('quiz-streak').textContent = state.streak;
  renderHearts();

  setTimeout(() => {
    if (state.hearts <= 0) {
      state.lastFailed = true;
      renderResult();
      showScreen('screen-result');
      return;
    }
    if (state.qIndex + 1 < state.quiz.length) {
      state.qIndex++;
      renderQuiz();
    } else {
      const ratio = state.correctCount / state.quiz.length;
      const stars = ratio === 1 ? 3 : ratio >= 0.66 ? 2 : 1;
      const bonus = 50;
      state.xp += bonus;
      state.lastGain = state.correctCount * 10 + bonus;
      state.lastFailed = false;
      state.progress[state.chapterId] = { done: true, stars };
      renderResult();
      showScreen('screen-result');
    }
  }, 900);
}

/* ---------------------------------------------------------
   Result screen
--------------------------------------------------------- */
function renderResult() {
  const chapter = CH_BY_ID[state.chapterId];
  const level = LEVEL_BY_ID[state.levelId];
  const levelIdx = LEVELS.findIndex(l => l.id === level.id);
  const ratio = state.correctCount / (state.quiz.length || 1);
  const stars = ratio === 1 ? 3 : ratio >= 0.66 ? 2 : 1;

  const icon = document.getElementById('result-icon');
  const title = document.getElementById('result-title');
  const text = document.getElementById('result-text');
  const starsEl = document.getElementById('result-stars');
  const actions = document.getElementById('result-actions');

  if (state.lastFailed) {
    icon.className = 'result-icon fail';
    icon.innerHTML = '<svg viewBox="0 0 24 24" width="40" height="40" fill="#FF5C5C" stroke="#FF5C5C"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.6l-1-1a5.5 5.5 0 0 0-7.8 7.8l1 1L12 21l7.8-7.6 1-1a5.5 5.5 0 0 0 0-7.8Z"/></svg>';
    title.textContent = 'Fast geschafft!';
    text.textContent = 'Die Herzen sind aufgebraucht. Versuch die Lektion noch einmal.';
    starsEl.innerHTML = '';
    actions.innerHTML = `
      <button class="btn-primary" onclick="retryChapter()">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="#0F2E2C" stroke-width="2.4"><path d="M1 4v6h6M23 20v-6h-6"/><path d="M20.5 9A9 9 0 0 0 5 5.3L1 10m22 4-4 4.7A9 9 0 0 1 3.5 15"/></svg>
        Nochmal versuchen
      </button>`;
  } else {
    const levelJustCompleted = level.chapters.every(id => state.progress[id].done);
    const nextLevel = LEVELS[levelIdx + 1];
    const unlockedNextLevel = levelJustCompleted && nextLevel;

    icon.className = 'result-icon win';
    icon.innerHTML = '<svg viewBox="0 0 24 24" width="40" height="40" fill="none" stroke="#F2B705" stroke-width="2"><path d="M8 21h8M12 17v4M7 4h10v5a5 5 0 0 1-10 0V4Z"/><path d="M7 5H4a2 2 0 0 0 2 4M17 5h3a2 2 0 0 1-2 4"/></svg>';
    title.textContent = `${chapter.stop} erreicht!`;
    text.textContent = unlockedNextLevel
      ? `Du hast ${chapter.title} abgeschlossen (+${state.lastGain} XP) und das Niveau „${nextLevel.name}“ freigeschaltet!`
      : `Du hast ${chapter.title} abgeschlossen und +${state.lastGain} XP gesammelt.`;
    starsEl.innerHTML = [0,1,2].map(s => `
      <svg viewBox="0 0 24 24" width="32" height="32" fill="${s < stars ? '#F2B705' : 'none'}" stroke="#F2B705" stroke-width="1.8">
        <path d="M12 2l2.9 6.6L22 9.3l-5 4.8 1.3 7-6.3-3.6L5.7 21l1.3-7-5-4.8 7.1-0.7L12 2z"/>
      </svg>`).join('');
    actions.innerHTML = `
      <button class="btn-primary mint" onclick="goToPath('${level.id}')">
        Weiter auf der Route
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="#0F2E2C" stroke-width="2.4"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
      </button>
      ${unlockedNextLevel ? `<button class="btn-secondary" onclick="goToLevels()">Niveaus ansehen</button>` : ''}`;
  }
}

function retryChapter() {
  state.cardIndex = 0;
  renderCard();
  showScreen('screen-cards');
}

/* ---------------------------------------------------------
   Init
--------------------------------------------------------- */
renderLevels();
</script>
